codex처럼 게임을 만들어줘

'Codex(코덱스)' 스타일로 게임을 만든다는 것은 **체계적이고 모듈화된 코드 구조(Clean Code)**와 확장 가능한 데이터 중심 설계를 의미합니다. 스타듀 밸리와 같은 복잡한 농사 시뮬레이션은 코드가 꼬이기 쉽기 때문에, 처음부터 구조를 잘 잡는 것이 중요합니다.

가장 대중적이고 배우기 쉬운 Phaser 3 (JavaScript) 엔진을 기반으로, 스타듀 밸리의 핵심인 **'레이어 시스템'**과 **'Y-Sorting(깊이 조절)'**이 포함된 코덱스형 구조를 설계해 드릴게요.

1. 프로젝트 구조 (The Codex Structure)

Apply
project-root/
│
├── index.html          # 게임 실행 파일
├── src/
│   ├── main.js         # 게임 설정 및 씬 관리
│   ├── Player.js       # 플레이어 캐릭터 클래스
│   ├── MapManager.js   # 맵 로딩 및 타일 설정
│   └── EntityManager.js # 작물, NPC, 아이템 관리
└── assets/             # 이미지 및 맵 데이터 (JSON)
2. 핵심 구현: 메인 엔진 설정 (main.js)
이 코드는 게임의 뼈대를 잡고 맵을 불러오는 역할을 합니다.


Apply
// src/main.js
import { Player } from './Player.js';
import { MapManager } from './MapManager.js';

const config = {
    type: Phaser.AUTO,
    width: 800,
    height: 600,
    pixelArt: true, // 스타듀 밸리 같은 도트 그래픽을 위해 필수
    physics: {
        default: 'arcade',
        arcade: { gravity: { y: 0 } }
    },
    scene: {
        preload: preload,
        create: create,
        update: update
    }
};

const game = new Phaser.Game(config);

function preload() {
    // 타일셋과 캐릭터 시트 로드
    this.load.image('tiles', 'assets/terrain_tiles.png');
    this.load.tilemapTiledJSON('map', 'assets/farm_map.json');
    this.load.spritesheet('player', 'assets/player_sheet.png', { frameWidth: 32, frameHeight: 32 });
}

function create() {
    this.mapManager = new MapManager(this);
    this.player = new Player(this, 400, 300);

    // 카메라가 플레이어를 따라다니게 설정 (스타듀 밸리 스타일)
    this.cameras.main.startFollow(this.player);
    this.cameras.main.setZoom(2); // 도트 그래픽을 크게 보기 위해 확대
}

function update() {
    this.player.update();
    // Y-Sorting: 캐릭터가 나무 뒤로 가면 가려지고, 앞으로 오면 나타나게 함
    this.children.each(c => {
        if (c.depth !== undefined) c.setDepth(c.y);
    });
}
3. 스타듀 밸리 퀄리티의 핵심: MapManager.js
스타듀 밸리의 맵은 여러 층(Layer)으로 나뉩니다. 이를 코덱스 방식으로 관리합니다.


Apply
// src/MapManager.js
export class MapManager {
    constructor(scene) {
        this.scene = scene;
        this.map = scene.make.tilemap({ key: 'map' });
        
        // 타일셋 이름은 Tiled 프로그램에서 설정한 이름과 같아야 함
        const tileset = this.map.addTilesetImage('stardew_tileset', 'tiles');

        // 1. 바닥 레이어 (잔디, 흙) - 충돌 없음
        this.groundLayer = this.map.createLayer('Ground', tileset, 0, 0);

        // 2. 충돌 레이어 (벽, 울타리, 연못)
        this.worldLayer = this.map.createLayer('World', tileset, 0, 0);
        this.worldLayer.setCollisionByProperty({ collides: true });

        // 3. 상단 레이어 (지붕, 나무 꼭대기) - 플레이어보다 위에 그려짐
        this.topLayer = this.map.createLayer('Above', tileset, 0, 0);
        this.topLayer.setDepth(9999); // 항상 최상단
    }
}
4. 플레이어 제어 및 상호작용 (Player.js)

Apply
// src/Player.js
export class Player extends Phaser.Physics.Arcade.Sprite {
    constructor(scene, x, y) {
        super(scene, x, y, 'player');
        scene.add.existing(this);
        scene.physics.add.existing(this);
        
        this.cursors = scene.input.keyboard.createCursorKeys();
        this.speed = 150;
    }

    update() {
        this.body.setVelocity(0);

        // 상하좌우 이동
        if (this.cursors.left.isDown) this.body.setVelocityX(-this.speed);
        else if (this.cursors.right.isDown) this.body.setVelocityX(this.speed);

        if (this.cursors.up.isDown) this.body.setVelocityY(-this.speed);
        else if (this.cursors.down.isDown) this.body.setVelocityY(this.speed);

        // 애니메이션 처리 (생략)
    }
}
