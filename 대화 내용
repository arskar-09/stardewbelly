<script>
/**
 * [Codex 스타일: Asset Factory]
 * 직접 에셋 이미지를 그리는 모듈
 */
const Assets = {
    textures: {},
    create() {
        const createTexture = (w, h, drawer) => {
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            drawer(ctx);
            return canvas;
        };

        // 1. 잔디 타일 (16x16)
        this.textures.grass = createTexture(16, 16, ctx => {
            ctx.fillStyle = '#78b83e'; ctx.fillRect(0, 0, 16, 16);
            ctx.fillStyle = '#68a337'; ctx.fillRect(2, 4, 2, 2); ctx.fillRect(10, 12, 2, 1);
        });

        // 2. 흙 타일 (16x16)
        this.textures.dirt = createTexture(16, 16, ctx => {
            ctx.fillStyle = '#9b6b43'; ctx.fillRect(0, 0, 16, 16);
            ctx.fillStyle = '#855a36'; ctx.fillRect(4, 4, 4, 1);
        });

        // 3. 나무 (32x48)
        this.textures.tree = createTexture(32, 48, ctx => {
            ctx.fillStyle = '#6d4c2a'; ctx.fillRect(12, 32, 8, 16); // 기둥
            ctx.fillStyle = '#2d6330'; // 잎사귀
            ctx.beginPath(); ctx.arc(16, 20, 16, 0, Math.PI * 2); ctx.fill();
            ctx.fillStyle = '#3a7d3e'; ctx.beginPath(); ctx.arc(12, 15, 10, 0, Math.PI * 2); ctx.fill();
        });

        // 4. 돌 (16x16)
        this.textures.rock = createTexture(16, 16, ctx => {
            ctx.fillStyle = '#8c8c8c'; ctx.beginPath(); ctx.ellipse(8, 10, 6, 4, 0, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = '#b0b0b0'; ctx.fillRect(5, 7, 3, 2);
        });

        // 5. 플레이어 (16x24)
        this.textures.player = createTexture(16, 24, ctx => {
            ctx.fillStyle = '#ffdbac'; ctx.fillRect(4, 4, 8, 8); // 얼굴
            ctx.fillStyle = '#3d3126'; ctx.fillRect(4, 2, 8, 3); // 머리카락
            ctx.fillStyle = '#2a4d9b'; ctx.fillRect(4, 12, 8, 8); // 몸통
            ctx.fillStyle = '#1a1a1a'; ctx.fillRect(4, 20, 3, 4); ctx.fillRect(9, 20, 3, 4); // 다리
        });
    }
};

/**
 * [Codex 스타일: Map Manager]
 */
class MapManager {
    constructor(width, height) {
        this.width = width;
        this.height = height;
        this.tiles = [];
        this.objects = [];
        this.init();
    }

    init() {
        // 기본 바닥 생성
        for (let y = 0; y < this.height; y++) {
            this.tiles[y] = [];
            for (let x = 0; x < this.width; x++) {
                this.tiles[y][x] = Math.random() > 0.1 ? 'grass' : 'dirt';
                
                // 랜덤 나무/돌 배치 (이미지 느낌 재현)
                if (Math.random() < 0.05) {
                    this.objects.push({ type: 'tree', x: x * 16, y: y * 16, width: 32, height: 48, pivotY: 44 });
                } else if (Math.random() < 0.08) {
                    this.objects.push({ type: 'rock', x: x * 16, y: y * 16, width: 16, height: 16, pivotY: 12 });
                }
            }
        }
    }
}

/**
 * [Codex 스타일: Engine Core]
 */
class Game {
    constructor() {
        this.canvas = document.getElementById('gameCanvas');
        this.ctx = this.canvas.getContext('2d');
        this.canvas.width = 640;
        this.canvas.height = 480;
        this.scale = 3;

        Assets.create();
        this.map = new MapManager(20, 15);
        this.player = { x: 100, y: 100, vx: 0, vy: 0, speed: 2 };
        this.keys = {};

        window.addEventListener('keydown', e => this.keys[e.code] = true);
        window.addEventListener('keyup', e => this.keys[e.code] = false);

        this.loop();
    }

    update() {
        if (this.keys['ArrowUp']) this.player.y -= this.player.speed;
        if (this.keys['ArrowDown']) this.player.y += this.player.speed;
        if (this.keys['ArrowLeft']) this.player.x -= this.player.speed;
        if (this.keys['ArrowRight']) this.player.x += this.player.speed;
    }

    draw() {
        const ctx = this.ctx;
        ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        ctx.save();
        ctx.scale(this.scale, this.scale);

        // 1. 바닥 레이어
        for (let y = 0; y < this.map.height; y++) {
            for (let x = 0; x < this.map.width; x++) {
                const tex = Assets.textures[this.map.tiles[y][x]];
                ctx.drawImage(tex, x * 16, y * 16);
            }
        }

        // 2. 상호작용 커서 (이미지의 주황색 칸)
        const cursorX = Math.floor((this.player.x + 8) / 16) * 16;
        const cursorY = Math.floor((this.player.y + 16) / 16) * 16;
        ctx.strokeStyle = 'orange';
        ctx.lineWidth = 1;
        ctx.strokeRect(cursorX, cursorY, 16, 16);

        // 3. Y-Sorting 정렬 레이어 (플레이어와 오브젝트 통합 정렬)
        const renderList = [
            { type: 'player', x: this.player.x, y: this.player.y, tex: Assets.textures.player, depth: this.player.y + 24 },
            ...this.map.objects.map(obj => ({ ...obj, tex: Assets.textures[obj.type], depth: obj.y + obj.pivotY }))
        ];

        renderList.sort((a, b) => a.depth - b.depth);

        renderList.forEach(item => {
            if (item.type === 'tree') {
                ctx.drawImage(item.tex, item.x - 8, item.y - 32); // 나무는 아래쪽이 기준점
            } else {
                ctx.drawImage(item.tex, item.x, item.y);
            }
        });

        ctx.restore();
    }

    loop() {
        this.update();
        this.draw();
        requestAnimationFrame(() => this.loop());
    }
}

new Game();
</script>
</body>
